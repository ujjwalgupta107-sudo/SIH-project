POSTGRES_DB=civicshield
POSTGRES_USER=civicshield
POSTGRES_PASSWORD=use-a-local-development-password
DATABASE_URL=postgresql+psycopg://civicshield:${POSTGRES_PASSWORD}@localhost:5432/civicshield
JWT_SECRET=use-a-minimum-32-character-secret-from-a-secret-manager
AI_SERVICE_URL=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_STYLE_URL=

# Email notification (optional — leave empty to disable, status will be SKIPPED)
# Tested with Gmail (use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL=authority-inbox@example.com
